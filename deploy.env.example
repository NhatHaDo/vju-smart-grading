# Sao chép thành deploy.env trên server (KHÔNG commit)
# Tạo khóa:  openssl rand -hex 32
JWT_SECRET_KEY=
# Domain công khai của app (có https://), nhiều domain cách nhau bằng dấu phẩy
CORS_ORIGINS=https://scoring.example.edu.vn
# Cổng nội bộ để reverse proxy / kiểm tra trực tiếp
WEB_PORT=8080
# Chỉ cần khi dùng Cloudflare Tunnel (lấy ở Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
