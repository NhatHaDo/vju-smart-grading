# Sao chép thành  backend/.env  trên server (file này bị .gitignore, KHÔNG commit)
# Tạo khóa:  openssl rand -hex 32
JWT_SECRET_KEY=
# Domain công khai có https://, nhiều domain cách nhau dấu phẩy (thêm cả http://172.16.12.95:10000 khi thử nội bộ)
CORS_ORIGINS=http://172.16.12.95:10000
# Dữ liệu nằm NGOÀI thư mục code để git pull / deploy không đụng tới — đưa thư mục này vào lịch backup
DATABASE_URL=sqlite:////home/scoring/vju-data/vju_smart_grading.db
OMR_UPLOAD_DIR=/home/scoring/vju-data/uploads
OMR_OUTPUT_DIR=/home/scoring/vju-data/outputs
# Giao diện đã build (backend phục vụ luôn, không cần nginx)
FRONTEND_DIST=/home/scoring/vju-smart-grading/frontend/dist
